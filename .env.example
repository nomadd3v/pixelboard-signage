# Pixelboard configuration — copy to .env.local and fill in.

# Port the dashboard binds to (the code default is 3006).
PORT=3006

# Owner master key — gates the dashboard + ingest. If unset, the dashboard is
# OPEN (dev only). Required in any shared/prod deployment.
VELLUM_MASTER_KEY=

# Secret used to sign session cookies (owner + per-site client). If unset, an
# ephemeral per-process secret is generated and sessions die on restart.
VELLUM_SESSION_SECRET=

# Set to 1 (or NODE_ENV=production) to add the Secure flag to session cookies.
# Required once served over HTTPS so the session never rides plaintext.
VELLUM_SECURE_COOKIES=0

# --- AI chat (ADR-003) — the editor's plain-English half ---
# Set one provider key to enable the chat box. If neither is set, AI chat is
# disabled (the box is hidden and the endpoint returns 503).
# ANTHROPIC_API_KEY=          # default provider (official SDK)
# OPENROUTER_API_KEY=         # OpenAI-compatible fallback
# VELLUM_AI_PROVIDER=         # force 'anthropic' | 'openrouter' | 'mock' (else inferred)
# VELLUM_AI_MODEL=claude-opus-4-8            # Anthropic model
# VELLUM_OPENROUTER_MODEL=anthropic/claude-sonnet-4.5   # OpenRouter model
