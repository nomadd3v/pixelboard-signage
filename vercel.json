{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "outputDirectory": "public",
  "functions": {
    "api/index.js": {
      "maxDuration": 120,
      "includeFiles": "{src/editor/**,src/studio/**,public/**,node_modules/fabric/dist/index.min.mjs}"
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index" }]
}
